#include <windows.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_CONFIG DIALOGEX 0, 0, 300, 350
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Crossfade Output Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Automatic track change", -1, 7, 7, 286, 122
    AUTOCHECKBOX    "Crossfade between tracks (when off, tracks play gaplessly)", IDC_XFADE, 14, 20, 270, 10
    LTEXT           "Crossfade length:", IDC_XFADE_MS_LABEL, 26, 37, 80, 8
    EDITTEXT        IDC_XFADE_MS, 110, 35, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 154, 37, 20, 8
    LTEXT           "Fade curve:", -1, 26, 54, 80, 8
    COMBOBOX        IDC_CURVE, 110, 52, 130, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Skip silence at the end of a track", IDC_TRIM_TAIL, 26, 70, 170, 10
    AUTOCHECKBOX    "Skip silence at the start of the next track", IDC_TRIM_HEAD, 26, 84, 170, 10
    LTEXT           "Below  -", IDC_SILENCE_LABEL, 214, 78, 32, 8
    EDITTEXT        IDC_SILENCE_DB, 246, 76, 24, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "dB", -1, 274, 78, 14, 8
    AUTOCHECKBOX    "Detect fade-outs and bring the next track in during the fade", IDC_SMART_FADE, 26, 98, 260, 10
    AUTOCHECKBOX    "Beat sync: shift the crossfade so both tracks' beats line up", IDC_BEAT_SYNC, 26, 112, 260, 10

    GROUPBOX        "Fades", -1, 7, 134, 286, 78
    LTEXT           "Fade in when playback starts:", -1, 14, 149, 180, 8
    EDITTEXT        IDC_FADE_START, 200, 147, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 244, 149, 20, 8
    LTEXT           "Fade out on stop / crossfade on manual skip:", -1, 14, 165, 180, 8
    EDITTEXT        IDC_FADE_STOP, 200, 163, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 244, 165, 20, 8
    LTEXT           "Fade on pause and resume:", -1, 14, 181, 180, 8
    EDITTEXT        IDC_FADE_PAUSE, 200, 179, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 244, 181, 20, 8
    LTEXT           "Crossfade on seek:", -1, 14, 197, 180, 8
    EDITTEXT        IDC_FADE_SEEK, 200, 195, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 244, 197, 20, 8

    GROUPBOX        "Output (WASAPI shared mode)", -1, 7, 218, 286, 82
    LTEXT           "Device:", -1, 14, 233, 40, 8
    COMBOBOX        IDC_DEVICE, 60, 231, 226, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Buffer:", -1, 14, 250, 40, 8
    EDITTEXT        IDC_BUFFER_MS, 60, 248, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 104, 250, 15, 8
    LTEXT           "Device latency:", -1, 130, 250, 60, 8
    EDITTEXT        IDC_DEVICE_BUFFER_MS, 195, 248, 40, 12, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "ms", -1, 239, 250, 15, 8
    AUTOCHECKBOX    "Soft limiter (prevents clipping when loud tracks overlap)", IDC_LIMITER, 14, 267, 270, 10
    AUTOCHECKBOX    "Use Winamp's volume and balance controls", IDC_VOLUME, 14, 281, 270, 10

    LTEXT           "", IDC_LAST_INFO, 7, 306, 286, 18
    PUSHBUTTON      "Defaults", IDC_DEFAULTS, 7, 329, 60, 14
    DEFPUSHBUTTON   "OK", IDOK, 179, 329, 55, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 238, 329, 55, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XF_VERSION_MAJOR, XF_VERSION_MINOR, XF_VERSION_PATCH, 0
 PRODUCTVERSION XF_VERSION_MAJOR, XF_VERSION_MINOR, XF_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Crossfade output plugin for Winamp"
            VALUE "InternalName", "out_crossfade"
            VALUE "OriginalFilename", "out_crossfade.dll"
            VALUE "ProductName", "Winamp Crossfade Output"
            VALUE "LegalCopyright", "Copyright (c) 2026 karfam and contributors. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
